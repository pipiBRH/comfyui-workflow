   "properties": {
    "Node name for S&R": "TextEncodeQwenImage21"
   },
   "widgets_values": [
    "Change the outfits and the background in <image1> and keep everything else. <image1> is the canvas: keep the father, the mother, the little boy and the dog in exactly the same positions, poses, expressions and framing, and keep every person's face, hairstyle, body shape and build exactly as they are. <image2> is a close-up of the same father on the left, the boy in the middle and the mother on the right, and serves only as an extra reference for their faces. Dress the father in a cream cable-knit sweater and beige trousers, the mother in a long cream knit sweater dress, and the boy in a small cream cable-knit sweater and beige corduroy trousers, and give the dog a cream knitted scarf in place of its lace collar. Replace the white studio room with a bright minimalist room with warm beige plaster walls, a large arched window with sheer linen curtains and a light oak floor, with soft natural window light on the family that matches the original lighting.",
    "",
    2048
   ],
   "widgets_values_named": {
    "prompt": "Change the outfits and the background in <image1> and keep everything else. <image1> is the canvas: keep the father, the mother, the little boy and the dog in exactly the same positions, poses, expressions and framing, and keep every person's face, hairstyle, body shape and build exactly as they are. <image2> is a close-up of the same father on the left, the boy in the middle and the mother on the right, and serves only as an extra reference for their faces. Dress the father in a cream cable-knit sweater and beige trousers, the mother in a long cream knit sweater dress, and the boy in a small cream cable-knit sweater and beige corduroy trousers, and give the dog a cream knitted scarf in place of its lace collar. Replace the white studio room with a bright minimalist room with warm beige plaster walls, a large arched window with sheer linen curtains and a light oak floor, with soft natural window light on the family that matches the original lighting.",
